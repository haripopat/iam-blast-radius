      "tags": { "title": "Finance Ops" }
    },

    {
      "id": "AccessGroupId-platform-eng",
      "type": "group",
      "name": "platform-engineering"
    },
    {
      "id": "AccessGroupId-support",
      "type": "group",
      "name": "support"
    },
    {
      "id": "AccessGroupId-finance",
      "type": "group",
      "name": "finance"
    },

    {
      "id": "iam-ServiceId-etl-pipeline",
      "type": "service",
      "name": "etl-pipeline"
    },

    {
      "id": "crn:v1:bluemix:public:databases-for-postgresql:eu-gb:a/a1b2c3d4e5f6000000000000000000ab:pg-prod-01::",
      "type": "resource",
      "name": "northwind-prod-postgres",
      "tags": { "env": "production", "data": "customer-pii" }
    },
    {
      "id": "crn:v1:bluemix:public:cloud-object-storage:global:a/a1b2c3d4e5f6000000000000000000ab:cos-archive::",
      "type": "resource",
      "name": "northwind-archive-bucket",
      "tags": { "env": "production", "data": "invoice-archive" }
